{
  "name": "ramille",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@expo-google-fonts/spline-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "~22.20.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.63.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "node -e \"const f='expo-env.d.ts'; const fs=require('fs'); try { if (!fs.existsSync(f)) fs.writeFileSync(f, '/// <reference types=\\\"expo/types\\\" />\\n'); } catch (e) { console.warn('expo-env.d.ts non créé : ' + e.message); }\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "lint": "expo lint",
    "test": "TZ=Europe/Paris jest",
    "vercel-build": "expo export --platform web"
  },
  "private": true,
  "license": "AGPL-3.0-or-later",
  "jest": {
    "preset": "jest-expo",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "mjs",
      "cjs",
      "jsx",
      "json",
      "node"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "collectCoverageFrom": [
      "src/types/**/*.ts",
      "src/lib/**/*.ts",
      "src/constants/**/*.ts",
      "!src/**/*.test.ts",
      "!src/lib/database.types.ts"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/scripts/doublage-css.js"
    }
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "fflate": "0.7.5"
  }
}
